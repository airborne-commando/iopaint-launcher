#!/bin/bash

# Main launcher script for IOPaint
# This script handles the virtual environment and launches IOPaint with the user's configuration

# Get the directory where this script is located
Help() {
    echo "Usage: $0 [OPTIONS]"
    echo
    echo "Options:"
    echo "  /?              Show this help message"
    echo "  --edit-config   Edit the iopaint-user.sh configuration file, check the #comments"
    echo "  --gpu VENDOR    Set GPU vendor for this session only (nvidia, amd, cpu)"
    echo "  --set-perma-gpu VENDOR  Permanently set GPU vendor in config (nvidia, amd, cpu)"
    echo "  --show-config   Show current configuration file location and GPU setting"
    echo "  --download-config Download default configuration from official URL"
    echo "  --web-config    Launch IOPaint with web configuration interface"
    echo "  --import-web-config FILE  Import settings from web config JSON file"
    echo "  --sync-config   Sync settings between shell config and web config"
    echo
    echo "GPU Vendors:"
    echo "  nvidia  - Use NVIDIA GPU with CUDA"
    echo "  amd     - Use AMD GPU with ROCm" 
    echo "  cpu     - Use CPU only"
    echo
    echo "Server Access:"
    echo "  Web Config Interface: http://127.0.0.1:7860"
    echo "  Main IOPaint Interface: http://127.0.0.1:8080"
    echo
    echo "Configuration Management:"
    echo "  Shell config: ~/.config/iopaint/iopaint-user.sh"
    echo "  Web config:   ~/.config/iopaint/iopaint-config.json"
    echo "  Use --sync-config to keep both configs in sync"
    echo
    exit 0
}

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Default configuration URL
CONFIG_URL="https://gist.githubusercontent.com/airborne-commando/38d059e31274546e5bc9060516c735e9/raw/8e420885088c2f50f261b3f88d68b3d562063e53/iopaint-user.sh"

# Parse command line arguments
SESSION_GPU=""
SET_PERMA_GPU=""
SHOW_CONFIG=false
EDIT_CONFIG=false
DOWNLOAD_CONFIG=false
WEB_CONFIG=false
IMPORT_WEB_CONFIG=""
SYNC_CONFIG=false

while [[ $# -gt 0 ]]; do
    case $1 in
        /\?)
            Help
            ;;
        --edit-config)
            EDIT_CONFIG=true
            shift
            ;;
        --gpu)
            SESSION_GPU="$2"
            shift 2
            ;;
        --set-perma-gpu)
            SET_PERMA_GPU="$2"
            shift 2
            ;;
        --show-config)
            SHOW_CONFIG=true
            shift
            ;;
        --download-config)
            DOWNLOAD_CONFIG=true
            shift
            ;;
        --web-config)
            WEB_CONFIG=true
            shift
            ;;
        --import-web-config)
            IMPORT_WEB_CONFIG="$2"
            shift 2
            ;;
        --sync-config)
            SYNC_CONFIG=true
            shift
            ;;
        *)
            shift
            ;;
    esac
done

# Function to get device setting based on GPU vendor
get_device_setting() {
    local vendor="$1"
    case "$vendor" in
        nvidia)
            echo "cuda"
            ;;
        amd|cpu|*)
            echo "cpu"
            ;;
    esac
}

# Function to update device settings in shell config
update_device_settings() {
    local shell_config="$1"
    local gpu_vendor="$2"
    local device_setting=$(get_device_setting "$gpu_vendor")
    
    echo "🔄 Updating device settings for GPU vendor: $gpu_vendor"
    echo "📝 Setting all devices to: $device_setting"
    
    # Create backup
    cp "$shell_config" "$shell_config.bak.device.$(date +%Y%m%d_%H%M%S)"
    
    # Update device settings
    sed -i "s/^DEVICE=.*/DEVICE=\"$device_setting\"  # cpu, cuda, or mps/" "$shell_config"
    sed -i "s/^INTERACTIVE_SEG_DEVICE=.*/INTERACTIVE_SEG_DEVICE=\"$device_setting\"/" "$shell_config"
    sed -i "s/^REMOVE_BG_DEVICE=.*/REMOVE_BG_DEVICE=\"$device_setting\"/" "$shell_config"
    sed -i "s/^REALESRGAN_DEVICE=.*/REALESRGAN_DEVICE=\"$device_setting\"/" "$shell_config"
    sed -i "s/^GFPGAN_DEVICE=.*/GFPGAN_DEVICE=\"$device_setting\"/" "$shell_config"
    sed -i "s/^RESTOREFORMER_DEVICE=.*/RESTOREFORMER_DEVICE=\"$device_setting\"/" "$shell_config"
    
    echo "✅ Device settings updated for $gpu_vendor"
}

# Function to update device settings in JSON config
update_json_device_settings() {
    local json_config="$1"
    local gpu_vendor="$2"
    local device_setting=$(get_device_setting "$gpu_vendor")
    
    if [ ! -f "$json_config" ]; then
        echo "⚠️  JSON config not found, skipping device update: $json_config"
        return 0
    fi
    
    if ! command -v jq &> /dev/null; then
        echo "⚠️  jq not available, skipping JSON device update"
        return 1
    fi
    
    echo "🔄 Updating JSON device settings for GPU vendor: $gpu_vendor"
    echo "📝 Setting all devices to: $device_setting"
    
    # Create backup
    cp "$json_config" "$json_config.bak.device.$(date +%Y%m%d_%H%M%S)"
    
    # Update device settings in JSON
    jq --arg device "$device_setting" '
        .device = $device |
        .interactive_seg_device = $device |
        .remove_bg_device = $device |
        .realesrgan_device = $device |
        .gfpgan_device = $device |
        .restoreformer_device = $device
    ' "$json_config" > "${json_config}.tmp" && mv "${json_config}.tmp" "$json_config"
    
    echo "✅ JSON device settings updated for $gpu_vendor"
}

# Determine config file location
if [ -n "$XDG_CONFIG_HOME" ]; then
    CONFIG_DIR="$XDG_CONFIG_HOME/iopaint"
else
    CONFIG_DIR="${HOME}/.config/iopaint"
fi

USER_CONFIG="$CONFIG_DIR/iopaint-user.sh"
WEB_CONFIG_FILE="$CONFIG_DIR/iopaint-config.json"

# Create config directory if it doesn't exist
if [ ! -d "$CONFIG_DIR" ]; then
    mkdir -p "$CONFIG_DIR"
    echo "Created config directory: $CONFIG_DIR"
fi

# Function to convert JSON to shell variables
json_to_shell() {
    local json_file="$1"
    
    if [ ! -f "$json_file" ]; then
        echo "❌ JSON file not found: $json_file"
        return 1
    fi
    
    # Check if jq is available
    if ! command -v jq &> /dev/null; then
        echo "❌ jq is required for JSON processing but not installed."
        echo "Please install jq: sudo apt-get install jq (Ubuntu/Debian) or brew install jq (macOS)"
        return 1
    fi
    
    # Map JSON keys to shell variable names with proper formatting
    jq -r 'to_entries | .[] | select(.value != null) | 
        (if .key == "no_half" then "NO_HALF"
        elif .key == "low_mem" then "LOW_MEM" 
        elif .key == "cpu_offload" then "CPU_OFFLOAD"
        elif .key == "disable_nsfw_checker" then "DISABLE_NSFW_CHECKER"
        elif .key == "local_files_only" then "LOCAL_FILES_ONLY"
        elif .key == "cpu_textencoder" then "CPU_TEXTENCODER"
        elif .key == "inbrowser" then "IN_BROWSER"
        elif .key == "enable_interactive_seg" then "ENABLE_INTERACTIVE_SEG"
        elif .key == "interactive_seg_model" then "INTERACTIVE_SEG_MODEL"
        elif .key == "interactive_seg_device" then "INTERACTIVE_SEG_DEVICE"
        elif .key == "enable_remove_bg" then "ENABLE_REMOVE_BG"
        elif .key == "remove_bg_device" then "REMOVE_BG_DEVICE"
        elif .key == "remove_bg_model" then "REMOVE_BG_MODEL"
        elif .key == "enable_anime_seg" then "ENABLE_ANIME_SEG"
        elif .key == "enable_realesrgan" then "ENABLE_REALESRGAN"
        elif .key == "realesrgan_device" then "REALESRGAN_DEVICE"
        elif .key == "realesrgan_model" then "REALESRGAN_MODEL"
        elif .key == "enable_gfpgan" then "ENABLE_GFPGAN"
        elif .key == "gfpgan_device" then "GFPGAN_DEVICE"
        elif .key == "enable_restoreformer" then "ENABLE_RESTOREFORMER"
        elif .key == "restoreformer_device" then "RESTOREFORMER_DEVICE"
        elif .key == "model_dir" then "MODEL_DIR"
        elif .key == "input" then "INPUT"
        elif .key == "mask_dir" then "MASK_DIR"
        elif .key == "output_dir" then "OUTPUT_DIR"
        elif .key == "host" then "HOST"
        elif .key == "port" then "PORT"
        elif .key == "model" then "MODEL"
        elif .key == "device" then "DEVICE"
        elif .key == "quality" then "QUALITY"
        else .key | ascii_upcase end) + "=" + 
        (if .value | type == "string" then "\"" + .value + "\"" 
        else .value | tostring end)' "$json_file"
}

# Function to import web config to shell config
import_web_config() {
    local json_file="$1"
    local shell_config="$2"
    
    if [ ! -f "$json_file" ]; then
        echo "❌ Web config file not found: $json_file"
        return 1
    fi
    
    echo "Importing settings from: $json_file"
    echo "Target shell config: $shell_config"
    
    # Create backup
    cp "$shell_config" "$shell_config.bak.import.$(date +%Y%m%d_%H%M%S)"
    
    # Convert JSON to shell format
    local converted_config
    converted_config=$(json_to_shell "$json_file")
    
    if [ $? -ne 0 ]; then
        echo "❌ Failed to convert JSON to shell format"
        return 1
    fi
    
    # Create temporary file with clean config
    local temp_config
    temp_config=$(mktemp)
    
    {
        echo "#!/bin/bash"
        echo ""
        echo "# User configuration file for IOPaint"
        echo "# Web configuration imported on: $(date)"
        echo ""
        
        # Always preserve GPU_VENDOR and VENV_DIR from original
        grep -E "^(GPU_VENDOR|VENV_DIR)=" "$shell_config" || cat << 'EOF'
GPU_VENDOR="cpu"  # nvidia, amd, or cpu
VENV_DIR="${HOME}/.iopaint_venv"
EOF
        
        echo ""
        
        # Use all converted config except GPU/VENV settings
        echo "$converted_config" | grep -v -E "^(GPU_VENDOR|VENV_DIR)="
        
    } > "$temp_config"
    
    # Replace the original config
    mv "$temp_config" "$shell_config"
    
    echo "✅ Successfully imported web configuration"
    echo "💾 Backup created: $shell_config.bak.import.*"
    echo "📝 Updated: $shell_config"
    
    return 0
}

# Function to sync configurations
sync_configurations() {
    local shell_config="$1"
    local json_config="$2"
    
    echo "Syncing configurations..."
    echo "Shell: $shell_config"
    echo "JSON: $json_config"
    
    if [ ! -f "$shell_config" ]; then
        echo "❌ Shell configuration not found"
        return 1
    fi
    
    if [ ! -f "$json_config" ]; then
        echo "⚠️  JSON configuration not found, creating from shell config..."
        # This would require shell-to-json conversion
        echo "Currently only JSON-to-shell import is supported"
        return 1
    fi
    
    # For now, just import JSON to shell
    import_web_config "$json_config" "$shell_config"
}

# Handle --import-web-config
if [ -n "$IMPORT_WEB_CONFIG" ]; then
    import_web_config "$IMPORT_WEB_CONFIG" "$USER_CONFIG"
    exit $?
fi

# Handle --sync-config
if [ "$SYNC_CONFIG" = true ]; then
    sync_configurations "$USER_CONFIG" "$WEB_CONFIG_FILE"
    exit $?
fi

# Handle --download-config
if [ "$DOWNLOAD_CONFIG" = true ]; then
    echo "Downloading default configuration from: $CONFIG_URL"
    echo "Target: $USER_CONFIG"
    
    # Check for available download tools
    if command -v curl &> /dev/null; then
        if curl -fsSL "$CONFIG_URL" -o "$USER_CONFIG"; then
            echo "✅ Successfully downloaded configuration using curl"
            chmod +x "$USER_CONFIG"
        else
            echo "❌ Failed to download configuration using curl"
            exit 1
        fi
    elif command -v wget &> /dev/null; then
        if wget -q "$CONFIG_URL" -O "$USER_CONFIG"; then
            echo "✅ Successfully downloaded configuration using wget"
            chmod +x "$USER_CONFIG"
        else
            echo "❌ Failed to download configuration using wget"
            exit 1
        fi
    else
        echo "❌ Error: Neither curl nor wget is available for downloading"
        echo "Please install curl or wget, or create the configuration manually"
        exit 1
    fi
    
    # Verify the download was successful
    if [ -f "$USER_CONFIG" ] && [ -s "$USER_CONFIG" ]; then
        echo "Configuration successfully downloaded to: $USER_CONFIG"
        echo "You can now edit it with: $0 --edit-config"
        echo ""
        echo "To use the web configuration interface, run: $0 --web-config"
        exit 0
    else
        echo "❌ Error: Downloaded file is empty or missing"
        exit 1
    fi
fi

# Copy default config if no user config exists
if [ ! -f "$USER_CONFIG" ]; then
    echo "No user configuration found at: $USER_CONFIG"
    echo "You can:"
    echo "  1. Run '$0 --download-config' to download the default configuration"
    echo "  2. Run '$0 --edit-config' to create and edit a blank configuration"
    echo "  3. Create the file manually at: $USER_CONFIG"
    echo ""
    read -p "Would you like to download the default configuration now? (y/N): " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        # Use self-call to download config
        exec "$0" --download-config
    else
        echo "Please create a configuration file first."
        exit 1
    fi
fi

# Handle --show-config
if [ "$SHOW_CONFIG" = true ]; then
    echo "Configuration files:"
    echo "  Shell: $USER_CONFIG"
    echo "  Web:   $WEB_CONFIG_FILE"
    echo ""
    
    if [ -f "$USER_CONFIG" ]; then
        echo "Shell Config ($(wc -l < "$USER_CONFIG") lines):"
        echo "GPU Vendor: $(grep '^GPU_VENDOR=' "$USER_CONFIG" | cut -d'=' -f2 | tr -d '"' || echo 'not set')"
        echo "Device: $(grep '^DEVICE=' "$USER_CONFIG" | cut -d'=' -f2 | tr -d '"' || echo 'not set')"
        echo ""
    fi
    
    if [ -f "$WEB_CONFIG_FILE" ]; then
        echo "Web Config ($(wc -l < "$WEB_CONFIG_FILE") lines):"
        if command -v jq &> /dev/null; then
            echo "Device: $(jq -r '.device // "not set"' "$WEB_CONFIG_FILE")"
            jq -r '. | to_entries[] | select(.key | test("device")) | "  \(.key): \(.value)"' "$WEB_CONFIG_FILE"
        else
            echo "  Install jq to view JSON content properly"
        fi
    fi
    
    echo ""
    echo "Access URLs:"
    echo "  Web Config Interface: http://127.0.0.1:7860"
    echo "  Main IOPaint Interface: http://127.0.0.1:8080"
    echo ""
    echo "Management commands:"
    echo "  $0 --import-web-config $WEB_CONFIG_FILE"
    echo "  $0 --sync-config"
    exit 0
fi

# Handle --edit-config
if [ "$EDIT_CONFIG" = true ]; then
    ${EDITOR:-nano} "$USER_CONFIG"
    exit 0
fi

# Source the user configuration file
if ! source "$USER_CONFIG"; then
    echo "❌ Error: Failed to load configuration file: $USER_CONFIG"
    echo "The file may contain syntax errors. Please check or download a fresh copy with:"
    echo "  $0 --download-config"
    exit 1
fi

# Handle permanent GPU setting
if [ -n "$SET_PERMA_GPU" ]; then
    case $SET_PERMA_GPU in
        nvidia|amd|cpu)
            # Create backup
            cp "$USER_CONFIG" "$USER_CONFIG.bak.$(date +%Y%m%d_%H%M%S)"
            
            if grep -q "GPU_VENDOR=" "$USER_CONFIG"; then
                # Update existing GPU_VENDOR line
                sed -i "s/GPU_VENDOR=.*/GPU_VENDOR=\"$SET_PERMA_GPU\"/" "$USER_CONFIG"
            else
                # Add GPU_VENDOR line after the first comments
                sed -i "0,/^[^#]/s//GPU_VENDOR=\"$SET_PERMA_GPU\"\n&/" "$USER_CONFIG"
            fi
            
            echo "✅ Permanently set GPU vendor to: $SET_PERMA_GPU"
            
            # Update all device settings for the new GPU vendor
            update_device_settings "$USER_CONFIG" "$SET_PERMA_GPU"
            
            # Also update JSON config if it exists
            if [ -f "$WEB_CONFIG_FILE" ]; then
                update_json_device_settings "$WEB_CONFIG_FILE" "$SET_PERMA_GPU"
            fi
            
            echo "📁 Configuration updated in: $USER_CONFIG"
            echo "💾 Backup saved as: $USER_CONFIG.bak.*"
            
            # Reload the updated config
            source "$USER_CONFIG"
            ;;
        *)
            echo "❌ Error: Invalid GPU vendor. Use: nvidia, amd, or cpu"
            exit 1
            ;;
    esac
fi

# Handle session GPU override
if [ -n "$SESSION_GPU" ]; then
    case $SESSION_GPU in
        nvidia|amd|cpu)
            echo "🔧 Using GPU vendor for this session: $SESSION_GPU"
            GPU_VENDOR="$SESSION_GPU"
            
            # Override device settings for this session
            DEVICE_SETTING=$(get_device_setting "$SESSION_GPU")
            echo "📝 Setting all devices to: $DEVICE_SETTING for this session"
            
            # Override the device variables
            DEVICE="$DEVICE_SETTING"
            INTERACTIVE_SEG_DEVICE="$DEVICE_SETTING"
            REMOVE_BG_DEVICE="$DEVICE_SETTING"
            REALESRGAN_DEVICE="$DEVICE_SETTING"
            GFPGAN_DEVICE="$DEVICE_SETTING"
            RESTOREFORMER_DEVICE="$DEVICE_SETTING"
            ;;
        *)
            echo "❌ Error: Invalid GPU vendor. Use: nvidia, amd, or cpu"
            exit 1
            ;;
    esac
fi

# Check if Python 3.10 is available
if ! command -v python3.10 &> /dev/null; then
    echo "❌ Python 3.10 is required but not installed."
    exit 1
fi

# Create virtual environment if it doesn't exist
if [ ! -d "$VENV_DIR" ]; then
    echo "🐍 Creating virtual environment in $VENV_DIR..."
    echo "🎮 Using GPU vendor: $GPU_VENDOR"
    python3.10 -m venv "$VENV_DIR"
    source "$VENV_DIR/bin/activate"
    
    echo "📦 Installing PyTorch for $GPU_VENDOR..."
    case "$GPU_VENDOR" in
        nvidia)
            pip3 install torch==2.1.2 torchvision==0.16.2 --index-url https://download.pytorch.org/whl/cu118
            ;;
        amd)
            pip3 install torch==2.1.2 torchvision==0.16.2 --index-url https://download.pytorch.org/whl/rocm5.6
            ;;
        cpu|*)
            echo "Installing default PyTorch (CPU version)"
            pip3 install torch==2.1.2 torchvision==0.16.2
            ;;
    esac
    
    pip install --upgrade pip
    pip install iopaint
    
    # Install plugin dependencies if needed
    if [ "$ENABLE_REMOVE_BG" = true ] || [ "$ENABLE_ANIME_SEG" = true ] || [ "$ENABLE_INTERACTIVE_SEG" = true ]; then
        echo "🔌 Installing plugin dependencies (onnxruntime, rembg)..."
        pip install onnxruntime rembg
    fi
    
    # Install jq for JSON processing if not available
    if ! command -v jq &> /dev/null; then
        echo "📦 Installing jq for JSON processing..."
        if command -v apt-get &> /dev/null; then
            sudo apt-get update && sudo apt-get install -y jq
        elif command -v brew &> /dev/null; then
            brew install jq
        elif command -v dnf &> /dev/null; then
            sudo dnf install -y jq
        else
            echo "⚠️  Please install jq manually for JSON config support"
        fi
    fi
    
    deactivate
    echo "✅ Virtual environment created and iopaint installed."
fi

# For existing environments, check if we need to install additional dependencies
source "$VENV_DIR/bin/activate"
if [ "$ENABLE_REMOVE_BG" = true ] || [ "$ENABLE_ANIME_SEG" = true ] || [ "$ENABLE_INTERACTIVE_SEG" = true ]; then
    if ! pip show onnxruntime rembg &> /dev/null; then
        echo "🔌 Installing missing plugin dependencies (onnxruntime, rembg)..."
        pip install onnxruntime rembg
    fi
fi
deactivate

# Build the command based on whether web config is requested
if [ "$WEB_CONFIG" = true ]; then
    echo "🌐 Starting IOPaint with web configuration interface..."
    CMD="iopaint start-web-config --config-file \"$WEB_CONFIG_FILE\""
    WEB_CONFIG_PORT=7860
else
    # Build the standard command
    CMD="iopaint start --model=\"$MODEL\" --device=\"$DEVICE\" --port=\"$PORT\" --host=\"$HOST\" --model-dir=\"$MODEL_DIR\" --quality=\"$QUALITY\""

    # Add boolean flags
    [ "$IN_BROWSER" = true ] && CMD="$CMD --inbrowser"
    [ "$LOW_MEM" = true ] && CMD="$CMD --low-mem"
    [ "$NO_HALF" = true ] && CMD="$CMD --no-half"
    [ "$CPU_OFFLOAD" = true ] && CMD="$CMD --cpu-offload"
    [ "$DISABLE_NSFW_CHECKER" = true ] && CMD="$CMD --disable-nsfw-checker"
    [ "$CPU_TEXTENCODER" = true ] && CMD="$CMD --cpu-textencoder"
    [ "$LOCAL_FILES_ONLY" = true ] && CMD="$CMD --local-files-only"
    [ "$ENABLE_INTERACTIVE_SEG" = true ] && CMD="$CMD --enable-interactive-seg"
    [ "$ENABLE_REMOVE_BG" = true ] && CMD="$CMD --enable-remove-bg"
    [ "$ENABLE_ANIME_SEG" = true ] && CMD="$CMD --enable-anime-seg"
    [ "$ENABLE_REALESRGAN" = true ] && CMD="$CMD --enable-realesrgan"
    [ "$ENABLE_GFPGAN" = true ] && CMD="$CMD --enable-gfpgan"
    [ "$ENABLE_RESTOREFORMER" = true ] && CMD="$CMD --enable-restoreformer"

    # Add other options
    [ -n "$INTERACTIVE_SEG_MODEL" ] && CMD="$CMD --interactive-seg-model=\"$INTERACTIVE_SEG_MODEL\""
    [ -n "$INTERACTIVE_SEG_DEVICE" ] && CMD="$CMD --interactive-seg-device=\"$INTERACTIVE_SEG_DEVICE\""
    [ -n "$REMOVE_BG_DEVICE" ] && CMD="$CMD --remove-bg-device=\"$REMOVE_BG_DEVICE\""
    [ -n "$REMOVE_BG_MODEL" ] && CMD="$CMD --remove-bg-model=\"$REMOVE_BG_MODEL\""
    [ -n "$REALESRGAN_DEVICE" ] && CMD="$CMD --realesrgan-device=\"$REALESRGAN_DEVICE\""
    [ -n "$REALESRGAN_MODEL" ] && CMD="$CMD --realesrgan-model=\"$REALESRGAN_MODEL\""
    [ -n "$GFPGAN_DEVICE" ] && CMD="$CMD --gfpgan-device=\"$GFPGAN_DEVICE\""
    [ -n "$RESTOREFORMER_DEVICE" ] && CMD="$CMD --restoreformer-device=\"$RESTOREFORMER_DEVICE\""
    [ -n "$INPUT" ] && CMD="$CMD --input=\"$INPUT\""
    [ -n "$MASK_DIR" ] && CMD="$CMD --mask-dir=\"$MASK_DIR\""
    [ -n "$OUTPUT_DIR" ] && CMD="$CMD --output-dir=\"$OUTPUT_DIR\""
fi

# Display access information
echo ""
if [ "$WEB_CONFIG" = true ]; then
    echo "🌐 Web Configuration Interface: http://127.0.0.1:7860"
    echo "   This allows you to configure IOPaint through a web browser"
else
    echo "🌐 Main IOPaint Interface: http://$HOST:$PORT"
    echo "   Web Config also available at: http://127.0.0.1:7860"
fi

echo ""
echo "💡 After configuring in web interface, import settings with:"
echo "   $0 --import-web-config $WEB_CONFIG_FILE"

# Activate and run
echo ""
echo "🚀 Starting IOPaint with GPU vendor: $GPU_VENDOR"
echo "📁 Shell Config: $USER_CONFIG"
if [ "$WEB_CONFIG" = true ]; then
    echo "📄 Web Config File: $WEB_CONFIG_FILE"
fi
echo "🔧 Command: $CMD"
source "$VENV_DIR/bin/activate"
eval "$CMD"
deactivate