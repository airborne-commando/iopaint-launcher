#!/bin/bash

# Main launcher script for IOPaint
# This script handles the virtual environment and launches IOPaint with JSON configuration

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Configuration directory
CONFIG_DIR="${HOME}/.config/iopaint"
JSON_CONFIG="${CONFIG_DIR}/iopaint-config.json"

# Virtual environment directory
VENV_DIR="${HOME}/.iopaint_venv"

# GPU configuration
GPU_CONFIG="${CONFIG_DIR}/gpu-type"

# Ensure config directory exists
mkdir -p "$CONFIG_DIR"

# Function to detect and select GPU type
select_gpu_type() {
    # Check if GPU type is already configured
    if [ -f "$GPU_CONFIG" ]; then
        GPU_TYPE=$(cat "$GPU_CONFIG")
        echo "Using previously configured GPU type: $GPU_TYPE"
        return 0
    fi

    echo "GPU Configuration"
    echo "================="
    
    # Auto-detect available GPUs
    AUTO_DETECT=""
    if command -v nvidia-smi &> /dev/null; then
        AUTO_DETECT="NVIDIA GPU detected"
        DEFAULT=1
    elif lspci | grep -i amd/ati | grep -i vga &> /dev/null; then
        AUTO_DETECT="AMD GPU detected"
        DEFAULT=2
    else
        AUTO_DETECT="No dedicated GPU detected"
        DEFAULT=3
    fi

    echo "Auto-detection: $AUTO_DETECT"
    echo ""
    echo "Please select your GPU type:"
    echo "1) NVIDIA (CUDA)"
    echo "2) AMD (ROCm)" 
    echo "3) CPU only"
    echo "4) Auto-detect ($AUTO_DETECT)"
    echo ""
    
    while true; do
        read -p "Enter your choice [1-4] (default: $DEFAULT): " choice
        choice=${choice:-$DEFAULT}
        
        case $choice in
            1)
                GPU_TYPE="nvidia"
                echo "Selected: NVIDIA (CUDA)"
                break
                ;;
            2)
                GPU_TYPE="amd"
                echo "Selected: AMD (ROCm)"
                break
                ;;
            3)
                GPU_TYPE="cpu"
                echo "Selected: CPU only"
                break
                ;;
            4)
                # Use auto-detection
                if command -v nvidia-smi &> /dev/null; then
                    GPU_TYPE="nvidia"
                    echo "Auto-selected: NVIDIA (CUDA)"
                elif lspci | grep -i amd/ati | grep -i vga &> /dev/null; then
                    GPU_TYPE="amd"
                    echo "Auto-selected: AMD (ROCm)"
                else
                    GPU_TYPE="cpu"
                    echo "Auto-selected: CPU only"
                fi
                break
                ;;
            *)
                echo "Invalid choice. Please enter 1, 2, 3, or 4."
                ;;
        esac
    done

    # Save the selection
    echo "$GPU_TYPE" > "$GPU_CONFIG"
    echo "GPU configuration saved to $GPU_CONFIG"
    echo ""
}

# Function to setup virtual environment
setup_venv() {
    # Check if Python 3.10 is available
    if ! command -v python3.10 &> /dev/null; then
        echo "Python 3.10 is required but not installed."
        exit 1
    fi

    # Select GPU type if not already done
    select_gpu_type

    # Create virtual environment if it doesn't exist
    if [ ! -d "$VENV_DIR" ]; then
        echo "Creating virtual environment in $VENV_DIR..."
        python3.10 -m venv "$VENV_DIR"
        source "$VENV_DIR/bin/activate"
        
        # Install PyTorch based on GPU selection
        case "$GPU_TYPE" in
            nvidia)
                echo "Installing PyTorch with CUDA support..."
                pip3 install torch==2.1.2 torchvision==0.16.2 --index-url https://download.pytorch.org/whl/cu118
                ;;
            amd)
                echo "Installing PyTorch with ROCm support..."
                pip3 install torch==2.1.2 torchvision==0.16.2 --index-url https://download.pytorch.org/whl/rocm5.6
                ;;
            cpu|*)
                echo "Installing CPU-only PyTorch."
                pip3 install torch==2.1.2 torchvision==0.16.2
                ;;
        esac
        
        pip install --upgrade pip
        pip install iopaint
        
        # Install common plugin dependencies
        echo "Installing common plugin dependencies..."
        pip install onnxruntime rembg
        
        deactivate
        echo "Virtual environment created and iopaint installed."
    else
        # For existing environments, ensure plugin dependencies are installed
        source "$VENV_DIR/bin/activate"
        if ! pip show onnxruntime rembg &> /dev/null; then
            echo "Installing missing plugin dependencies..."
            pip install onnxruntime rembg
        fi
        deactivate
    fi
}

# Function to regenerate GPU configuration
regenerate_gpu_config() {
    echo "Regenerating GPU configuration..."
    rm -f "$GPU_CONFIG"
    select_gpu_type
    echo "GPU configuration updated. Please run the setup again to reinstall with the new GPU type."
}

# Function to generate configuration web interface
generate_config() {
    echo "Starting IOPaint configuration web interface..."
    
    # Ensure virtual environment is set up
    setup_venv
    
    source "$VENV_DIR/bin/activate"
    
    # Build the command for generating config
    CMD="iopaint start-web-config --config-file \"$JSON_CONFIG\""
    
    echo "Starting configuration interface with command:"
    echo "$CMD"
    eval "$CMD"
    
    deactivate
}

# Function to start IOPaint with JSON config
start_with_json_config() {
    if [ ! -f "$JSON_CONFIG" ]; then
        echo "JSON configuration file not found at $JSON_CONFIG"
        echo "Please generate one first using: $0 --gen-config"
        exit 1
    fi
    
    echo "Starting IOPaint with JSON configuration..."
    source "$VENV_DIR/bin/activate"
    CMD="iopaint start --config \"$JSON_CONFIG\""
    echo "Running: $CMD"
    eval "$CMD"
    deactivate
}

# Handle command line arguments
case "${1:-}" in
    "--gen-config")
        generate_config
        exit 0
        ;;
    "--gpu-setup")
        regenerate_gpu_config
        exit 0
        ;;
    "--help"|"-h")
        echo "IOPaint Launcher"
        echo ""
        echo "Usage: $0 [OPTION]"
        echo ""
        echo "Options:"
        echo "  (no option)        Start IOPaint with iopaint-config.json configuration"
        echo "  --gen-config       Generate configuration via web interface"
        echo "  --gpu-setup        Reconfigure GPU settings"
        echo "  --help, -h         Show this help message"
        exit 0
        ;;
esac

# Default startup behavior - use JSON config directly
if [ ! -f "$JSON_CONFIG" ]; then
    echo "JSON configuration file not found at $JSON_CONFIG"
    echo "Creating default configuration using web interface..."
    generate_config
    exit 0
fi

# Ensure virtual environment is set up
setup_venv

# Start IOPaint directly with JSON configuration
start_with_json_config